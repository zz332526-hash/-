<view class="page">
  <view class="hero">
    <view class="hero-top">
      <view>
        <view class="store-name">云上果茶·创意水果茶</view>
        <view class="store-meta">距离您 {{distance}}m · 评分 {{rating}}</view>
      </view>
      <view class="take-tag">{{takeType}}</view>
    </view>

    <scroll-view class="story-list" scroll-x enable-flex>
      <block wx:for="{{storyCards}}" wx:key="title">
        <view class="story-card">
          <view class="story-title">{{item.title}}</view>
          <view class="story-sub">{{item.sub}}</view>
        </view>
      </block>
    </scroll-view>
  </view>

  <view class="menu-layout">
    <view class="left-cat">
      <block wx:for="{{categories}}" wx:key="*this">
        <view class="cat {{currentCategory===item?'active':''}}" data-cat="{{item}}" bindtap="onSelectCategory">{{item}}</view>
      </block>
    </view>

    <view class="right-list">
      <block wx:for="{{currentProducts}}" wx:key="id">
        <view class="goods card">
          <image class="goods-img" src="{{item.image}}" mode="aspectFill" />
          <view class="goods-info">
            <view class="goods-name">{{item.name}}</view>
            <view class="goods-desc">{{item.desc}}</view>
            <view class="goods-tags">
              <text class="tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
            </view>
            <view class="goods-foot">
              <text class="price">¥{{item.price}}</text>
              <view class="qty-box">
                <button class="icon-btn" data-id="{{item.id}}" data-delta="-1" bindtap="onChangeQty">-</button>
                <text class="qty">{{item.qty || 0}}</text>
                <button class="icon-btn plus" data-id="{{item.id}}" data-delta="1" bindtap="onChangeQty">+</button>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="cartbar card">
    <view>
      <view class="light">已选 {{cartCount}} 件</view>
      <view class="total">合计 ¥{{cartTotal}}</view>
    </view>
    <view class="actions">
      <button class="switch" bindtap="onSwitchType">{{takeType}}</button>
      <button class="pay" bindtap="onCheckout" disabled="{{cartCount===0||paying}}">{{paying?'支付中...':'去付款'}}</button>
    </view>
  </view>
</view>

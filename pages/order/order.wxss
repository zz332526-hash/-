page { background: #f4f5f7; }
.page { padding: 20rpx 18rpx 160rpx; }
.card { background: #fff; border-radius: 24rpx; box-shadow: 0 6rpx 24rpx rgba(0,0,0,.05); }

.hero { background: linear-gradient(140deg, #1a1b1f, #2d2f35); border-radius: 24rpx; padding: 24rpx; color: #fff; }
.hero-top { display: flex; justify-content: space-between; align-items: center; }
.store-name { font-size: 42rpx; font-weight: 600; }
.store-meta { font-size: 24rpx; opacity: .76; margin-top: 10rpx; }
.take-tag { border: 1rpx solid rgba(255,255,255,.4); padding: 12rpx 18rpx; border-radius: 999rpx; font-size: 22rpx; }
.story-list { margin-top: 24rpx; white-space: nowrap; }
.story-card { width: 220rpx; display: inline-block; background: #fff; color: #111; border-radius: 16rpx; padding: 16rpx; margin-right: 14rpx; }
.story-title { font-size: 30rpx; font-weight: 600; }
.story-sub { font-size: 22rpx; color: #666; margin-top: 8rpx; }

.tabs { margin-top: 16rpx; display: flex; padding: 8rpx; }
.tab { flex: 1; text-align: center; padding: 16rpx 0; color: #777; font-size: 26rpx; }
.tab.active { color: #111; font-weight: 600; border-bottom: 5rpx solid #111; }

.menu-layout { margin-top: 12rpx; display: grid; grid-template-columns: 180rpx 1fr; gap: 12rpx; }
.left-cat { background: #f0f1f3; border-radius: 20rpx; padding: 12rpx; }
.cat { padding: 20rpx 10rpx; text-align: center; font-size: 24rpx; color: #666; border-radius: 14rpx; }
.cat.active { background: #fff; color: #111; font-weight: 600; }
.right-list { display: grid; gap: 12rpx; }

.goods { padding: 16rpx; display: grid; grid-template-columns: 144rpx 1fr; gap: 16rpx; }
.goods-img { width: 144rpx; height: 144rpx; border-radius: 14rpx; background: #f5f5f5; }
.goods-name { font-size: 30rpx; font-weight: 600; }
.goods-desc { margin-top: 8rpx; font-size: 22rpx; color: #777; }
.goods-tags { margin-top: 10rpx; }
.tag { font-size: 18rpx; color: #7c7c7c; border: 1rpx solid #dedede; border-radius: 8rpx; padding: 4rpx 8rpx; margin-right: 8rpx; }
.goods-foot { margin-top: 12rpx; display: flex; justify-content: space-between; align-items: center; }
.price { font-size: 36rpx; font-weight: 700; }
.qty-box { display: flex; align-items: center; gap: 8rpx; }
.icon-btn { width: 52rpx; height: 52rpx; line-height: 52rpx; border-radius: 50%; background: #f1f1f1; color: #111; padding: 0; }
.icon-btn.plus { background: #111; color: #fff; }
.qty { min-width: 30rpx; text-align: center; }

.cartbar { position: fixed; left: 18rpx; right: 18rpx; bottom: 20rpx; padding: 18rpx 20rpx; display: flex; justify-content: space-between; align-items: center; }
.light { font-size: 22rpx; color: #777; }
.total { margin-top: 6rpx; font-size: 34rpx; font-weight: 700; }
.actions { display: flex; gap: 10rpx; }
button { border-radius: 16rpx; font-size: 24rpx; }
.switch { background: #f2f2f2; color: #111; padding: 0 22rpx; }
.pay { background: #111; color: #fff; padding: 0 24rpx; }

.placeholder { margin-top: 12rpx; padding: 30rpx; }
.ph-title { font-size: 34rpx; font-weight: 600; }
.ph-desc { margin-top: 14rpx; color: #777; font-size: 24rpx; }

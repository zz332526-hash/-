.app { padding: 14rpx 12rpx 120rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04); }
.topbar { display: flex; justify-content: space-between; align-items: center; }
.title { margin-top: 8rpx; font-size: 36rpx; font-weight: 700; }
.muted { color: #777; font-size: 22rpx; }
.hero { margin-top: 16rpx; }
.hero-title { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.menu-layout { margin-top: 16rpx; display: grid; grid-template-columns: 180rpx 1fr; gap: 12rpx; }
.category { display: grid; gap: 10rpx; align-content: start; }
.cat-btn { padding: 16rpx; border-radius: 14rpx; background: #f5f5f5; text-align: center; font-size: 24rpx; }
.cat-btn.active { background: #111; color: #fff; }
.products { display: grid; gap: 12rpx; }
.product { background: #fff; border-radius: 20rpx; padding: 18rpx; display: grid; grid-template-columns: 1fr auto; gap: 8rpx; }
.name { font-size: 28rpx; font-weight: 600; }
.desc { margin: 8rpx 0; color: #777; font-size: 22rpx; }
.price { font-size: 28rpx; font-weight: 700; }
.controls { display: flex; align-items: center; gap: 8rpx; }
.count { min-width: 30rpx; text-align: center; }
button { background: #111; color: #fff; border-radius: 12rpx; }
button.ghost { background: #f0f0f0; color: #111; }
button.mini { height: 56rpx; line-height: 56rpx; padding: 0 18rpx; }
.cartbar { position: fixed; left: 12rpx; right: 12rpx; bottom: 16rpx; display: flex; justify-content: space-between; align-items: center; }
.total { font-size: 34rpx; font-weight: 700; }
